import numpy as np
a1=np.arange(12).reshape(3,4)
a2=np.arange(12,24).reshape(3,4)
print("Before Arithmatic Operations on a1:\n",a1)
print("Before Arithmatic Operations on a2:\n",a2)
print("After Multiplication operation on  a1:\n",a1*3)
print("After Addition Operation on a1:\n",a1+6)
print("After Subtraction Operation on a2:\n",a2-2)
print("After Division Operations on a2:\n",a1/4)



