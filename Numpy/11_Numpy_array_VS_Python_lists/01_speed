# Speed of list 
a=[i for i in range(10000000)]
b=[i for i in range(10000000,20000000)]
c=[]
import time
start1=time.time()
for i in range(len(a)):
    c.append(a[i]+b[i])
end1=time.time()    
print("Executuion Time required for list: ",end1-start1)

# Speed of numpy
