import numpy as np
a1=np.arange(10) #1D Array
print("Array is:",a1)
b=a1.ndim
print("No. of Dimensions: ",b)

a2=np.arange(12,dtype=float).reshape(3,4) #2D Array
print("Array is:\n",a2)
c=a2.ndim
print("No. of Dimensions: ",c)


a3=np.arange(8).reshape(2,2,2)
print("Array is:\n",a3)
d=a3.ndim
print("No. of Dimensions: ",d)

